{
  "name": "context",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k \"pnpm --filter @context/web dev\" \"tsx watch apps/api/src/index.ts\" \"tsx watch apps/worker/src/index.ts\"",
    "build": "pnpm typecheck && pnpm --filter @context/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @context/web typecheck",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:integration": "node scripts/integration.mjs",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed:demo": "tsx packages/db/src/seed.ts",
    "api": "tsx apps/api/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "hackathon:up": "node scripts/hackathon-up.mjs",
    "hackathon:import": "tsx scripts/hackathon-import.ts",
    "hackathon:seed": "tsx packages/db/src/corporate-seed.ts",
    "hackathon:evaluate": "tsx scripts/hackathon-evaluate.ts",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@context/agent": "workspace:*",
    "@context/config": "workspace:*",
    "@context/contracts": "workspace:*",
    "@context/db": "workspace:*",
    "@context/ui": "workspace:*",
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "bullmq": "6.4.0",
    "cheerio": "1.2.0",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "fast-xml-parser": "5.11.2",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "mammoth": "1.13.0",
    "multer": "2.5.0",
    "nodemailer": "10.2.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "pg-copy-streams": "7.0.0",
    "rss-parser": "3.13.0",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "22.19.0",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.15.6",
    "@types/pg-copy-streams": "1.2.5",
    "@types/supertest": "6.0.3",
    "@types/yauzl": "2.10.3",
    "concurrently": "9.2.1",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
