APP_VARIANT=alfa
APP_MODE=demo
COMPOSE_PROJECT_NAME=context-alfa-hackathon
PUBLIC_APP_URL=http://localhost:3010
DATABASE_URL=postgresql://context:alfa_local_only@localhost:15433/context
POSTGRES_PASSWORD=alfa_local_only
REDIS_URL=redis://localhost:16380
SESSION_SECRET=replace-with-random-at-least-32-characters
STORAGE_ROOT=.hackathon/files
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_FROM=Контекст <hackathon@example.test>
HACKATHON_DATA_ROOT=.hackathon
HACKATHON_LLM_BASE_URL=https://changellenge.up.railway.app/v1
# Backup URL supplied by organisers: https://api.alfahack-gateway26.ru/v1
HACKATHON_LLM_API_KEY=
HACKATHON_EXTRACT_MODEL=google/gemma-4-26b-a4b-it
HACKATHON_REASON_MODEL=z-ai/glm-5.3-flash
# Exact organiser API model ID -> approved family, for example {"organiser-model-id":"gemma-4-26b-a4b"}
HACKATHON_MODEL_REGISTRY={"google/gemma-4-26b-a4b-it":"gemma-4-26b-a4b","z-ai/glm-5.3-flash":"glm-5.3-flash","qwen/qwen3.6-35b-a3b":"qwen3.6-35b-a3b","deepseek/deepseek-v4.1-flash":"deepseek-v4.1-flash","qwen/qwen3-vl-30b-a3b-instruct":"qwen3-vl-30b-a3b-instruct","moonshotai/kimi-k2.6":"kimi-k2.6"}
# Per-model RUB per million tokens; unknown prices block live calls.
HACKATHON_MODEL_PRICES={}
HACKATHON_BUDGET_RUB=500
HACKATHON_BUDGET_TIMEZONE=Europe/Moscow
HACKATHON_BUDGET_RESET_HOUR=3
HACKATHON_OUTPUT_TOKENS=2048
BRAVE_SEARCH_API_KEY=
RUN_MAX_SEARCH=6
RUN_MAX_PAGES=12
RUN_MAX_LLM=12
RUN_MAX_TOKENS=60000
RUN_MAX_MS=600000
NEXT_TELEMETRY_DISABLED=1
