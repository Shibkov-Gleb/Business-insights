generator client {
 provider = "prisma-client"
 output = "../generated"
}
datasource db {
 provider = "postgresql"
}
model DatasetImport {
 id String @id @default(uuid()) @db.Uuid
 kind String
 filename String
 sha256 String @unique
 status String @default("staging")
 rows Int @default(0)
 settings Json @default("{}")
 report Json @default("{}")
 createdAt DateTime @default(now()) @db.Timestamptz
}
model CorporateCompany {
 id String @id @default(uuid()) @db.Uuid
 externalId String @unique
 name String
 datasetId String? @db.Uuid
 groupId String?
 orgId String? @db.Uuid
 scopeId String? @unique @db.Uuid
 version Int @default(1)
 synthetic Boolean @default(false)
 unknown Boolean @default(false)
 fields Json @default("{}")
 conflicts String[] @default([])
 revenue Decimal? @db.Decimal(30, 6)
 sourceRow Int?
 @@index([groupId])
 @@index([datasetId, revenue])
}
model CompanyVariant {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 datasetId String @db.Uuid
 sourceRow Int
 fields Json
 @@unique([datasetId, sourceRow])
 @@index([companyId])
}
model PersonCompanyLink {
 id BigInt @id @default(autoincrement())
 datasetId String @db.Uuid
 personId String
 companyExternalId String
 sourceRow Int
 fields Json
 @@unique([datasetId, sourceRow])
 @@index([companyExternalId])
 @@index([personId])
}
model PaymentEdge {
 id BigInt @id @default(autoincrement())
 datasetId String @db.Uuid
 sourceRow Int
 payer String
 beneficiary String
 amount Decimal @db.Decimal(38, 6)
 count BigInt
 @@unique([datasetId, sourceRow])
 @@index([payer, amount])
 @@index([beneficiary, amount])
}
model CompanyGrant {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 companyId String @db.Uuid
 canEdit Boolean @default(false)
 role String @default("employee")
 interests String[] @default([])
 @@unique([userId, companyId])
 @@index([companyId])
}
model BankMaterial {
 id String @id @default(uuid()) @db.Uuid
 title String
 filename String
 sha256 String @unique
 storageKey String
 sourceUrl String?
 publishedAt DateTime? @db.Timestamptz
 dateStatus String @default("unknown")
 status String @default("queued")
 pages Int @default(0)
 coverage Json @default("{}")
 createdAt DateTime @default(now()) @db.Timestamptz
}
model BankPage {
 id String @id @default(uuid()) @db.Uuid
 materialId String @db.Uuid
 page Int
 text String
 method String
 quality Float
 boxes Json @default("[]")
 numericVerified Boolean @default(false)
 @@unique([materialId, page])
}
model CorporateNews {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 title String
 text String
 url String?
 sha256 String
 publishedAt DateTime? @db.Timestamptz
 origin String
 createdBy String @db.Uuid
 synthetic Boolean @default(false)
 createdAt DateTime @default(now()) @db.Timestamptz
 insights CorporateInsight[]
 @@unique([companyId, sha256])
 @@index([companyId, publishedAt])
}
model CorporateInsight {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 runId String @db.Uuid
 newsId String @db.Uuid
 news CorporateNews @relation(fields: [newsId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "insight_news")
 contextVersion Int
 data Json
 evidence Json
 score Int
 channels String[]
 synthetic Boolean @default(false)
 analysisKey String @default("legacy")
 latestRevisionId String? @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz
 @@unique([companyId, newsId, contextVersion])
 @@index([companyId, createdAt, id])
}
model CorporateInsightRevision {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 insightId String @db.Uuid
 runId String @db.Uuid
 fingerprint String
 analysisKey String
 contextVersion Int
 data Json
 evidence Json
 score Int
 channels String[]
 synthetic Boolean
 createdAt DateTime @default(now()) @db.Timestamptz
 @@unique([insightId, fingerprint])
 @@index([companyId, createdAt])
 @@index([insightId, createdAt, id])
}
model CorporateTrace {
 id String @id @default(uuid()) @db.Uuid
 runId String @db.Uuid
 stage String
 tool String
 status String
 durationMs Int
 data Json
 createdAt DateTime @default(now()) @db.Timestamptz
 @@index([runId, createdAt])
}
model CorporateChat {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 userId String @db.Uuid
 insightId String? @db.Uuid
 role String
 question String
 answer String?
 evidence Json @default("[]")
 runId String? @unique @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz
 @@index([companyId, userId, createdAt])
}
model CorporateFeedback {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 insightId String @db.Uuid
 userId String @db.Uuid
 verdict String
 comment String
 reviewStatus String @default("open")
 expertNote String?
 createdAt DateTime @default(now()) @db.Timestamptz
 @@index([companyId, createdAt])
}
model DailyBudget {
 id String @id
 day String
 keyHash String
 cap BigInt
 reserved BigInt @default(0)
 spent BigInt @default(0)
 @@unique([keyHash, day])
}
model BudgetReservation {
 id String @id @default(uuid()) @db.Uuid
 budgetId String
 runId String @db.Uuid
 model String
 estimated BigInt
 actual BigInt?
 status String @default("reserved")
 inputTokens Int?
 outputTokens Int?
 createdAt DateTime @default(now()) @db.Timestamptz
 @@index([budgetId, status])
 @@index([runId])
}
model User {
 id String @id @default(uuid()) @db.Uuid
 email String @unique
 passwordHash String
 verified Boolean @default(false)
 timezone String @default("Europe/Moscow")
 createdAt DateTime @default(now()) @db.Timestamptz
}
model Session {
 id String @id
 userId String? @db.Uuid
 csrf String
 expiresAt DateTime @db.Timestamptz
 @@index([userId])
}
model AuthToken {
 id String @id
 userId String @db.Uuid
 kind String
 expiresAt DateTime @db.Timestamptz
}
model Organization {
 id String @id @default(uuid()) @db.Uuid
 name String
 stage String
 description String
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz
}
model Membership {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 userId String @db.Uuid
 role String
 allScopes Boolean @default(true)
 scopeIds String[] @default([])
 workRole String @default("founder")
 interests String[] @default([])
 @@unique([orgId,userId])
}
model Invitation {
 id String @id @default(uuid()) @db.Uuid
 tokenHash String @unique
 orgId String @db.Uuid
 email String?
 role String
 allScopes Boolean
 scopeIds String[]
 expiresAt DateTime @db.Timestamptz
 acceptedAt DateTime? @db.Timestamptz
 revoked Boolean @default(false)
}
model AnalysisScope {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 name String
 isDefault Boolean @default(false)
 version Int @default(1)
 cursorAt DateTime? @db.Timestamptz
 cursorVersion Int @default(0)
 settings Json @default("{}")
 @@index([orgId])
}
model ProfileVersion {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String? @db.Uuid
 version Int
 fields Json
 createdBy String @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz
 @@index([orgId,scopeId,version])
}
model ProfileProposal {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String? @db.Uuid
 documentId String? @db.Uuid
 expectedVersion Int
 fields Json
 status String @default("proposed")
 createdAt DateTime @default(now()) @db.Timestamptz
}
model Document {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String? @db.Uuid
 name String
 extension String
 storageKey String
 hash String
 size Int
 status String @default("uploaded")
 coverage Json @default("{}")
 createdBy String @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz
 @@index([orgId,scopeId])
}
model DocumentChunk {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String? @db.Uuid
 documentId String @db.Uuid
 text String
 locator Json
 @@index([documentId])
 @@index([orgId,scopeId])
}
model Competitor {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String @db.Uuid
 identity String
 name String
 data Json
 decision String
 monitoring String
 fingerprint String
 revision Int @default(1)
 userEdited Boolean @default(false)
 @@unique([scopeId,identity])
}
model SourceDocument {
 id String @id @default(uuid()) @db.Uuid
 canonicalUrl String @unique
 title String
 publisher String
 language String
 publishedAt DateTime? @db.Timestamptz
 updatedAt DateTime? @db.Timestamptz
 fetchedAt DateTime @default(now()) @db.Timestamptz
 checksum String
 text String
 status String
 provenance Json
}
model InsightRun {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String @db.Uuid
 userId String @db.Uuid
 kind String @default("analysis")
 resourceId String?
 mode String @default("normal")
 status String @default("queued")
 windowFrom DateTime @db.Timestamptz
 windowTo DateTime @db.Timestamptz
 cursorVersion Int @default(0)
 snapshot Json
 coverage Json @default("{}")
 budget Json @default("{}")
 error String?
 acceptedAt DateTime @default(now()) @db.Timestamptz
 finishedAt DateTime? @db.Timestamptz
 @@index([orgId,scopeId,acceptedAt])
}
model Event {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String @db.Uuid
 identity String
 createdAt DateTime @default(now()) @db.Timestamptz
 @@unique([scopeId,identity])
}
model EventRevision {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String @db.Uuid
 eventId String @db.Uuid
 fingerprint String
 sourceIds Json
 summary String
 createdAt DateTime @default(now()) @db.Timestamptz
 @@unique([eventId,fingerprint])
}
model Idempotency {
 id String @id
 userId String @db.Uuid
 payloadHash String
 resourceId String @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz
}
model Outbox {
 id String @id @db.Uuid
 deliveredAt DateTime? @db.Timestamptz
 createdAt DateTime @default(now()) @db.Timestamptz
}
model RunEvent {
 id BigInt @id @default(autoincrement())
 runId String @db.Uuid
 type String
 data Json
 createdAt DateTime @default(now()) @db.Timestamptz
 @@index([runId,id])
}
model Insight {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String @db.Uuid
 eventKey String
 title String
 severity String
 potentialSeverity String?
 confidence String
 lifecycle String @default("active")
 workStatus String @default("open")
 latestRevisionId String? @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
 @@unique([scopeId,eventKey])
}
model InsightRevision {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String @db.Uuid
 insightId String @db.Uuid
 runId String @db.Uuid
 fingerprint String
 profileVersionId String
 data Json
 evidence Json
 createdAt DateTime @default(now()) @db.Timestamptz
 @@unique([insightId,fingerprint,profileVersionId])
}
model ReadState {
 userId String @db.Uuid
 insightId String @db.Uuid
 at DateTime @default(now()) @db.Timestamptz
 @@id([userId,insightId])
}
model ChatThread {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String @db.Uuid
 userId String @db.Uuid
 insightId String? @db.Uuid
 title String
 visibility String @default("private")
 createdAt DateTime @default(now()) @db.Timestamptz
}
model ChatMessage {
 id String @id @default(uuid()) @db.Uuid
 threadId String @db.Uuid
 userId String? @db.Uuid
 role String
 content String
 citations Json @default("[]")
 status String @default("complete")
 createdAt DateTime @default(now()) @db.Timestamptz
}
model Decision {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String @db.Uuid
 userId String @db.Uuid
 threadId String? @db.Uuid
 briefId String? @unique @db.Uuid
 text String
 assertion String @default("hypothesis")
 createdAt DateTime @default(now()) @db.Timestamptz
}

model SourceSnapshot {
 id String @id @default(uuid()) @db.Uuid
 canonicalUrl String
 title String
 text String
 checksum String
 publishedAt DateTime? @db.Timestamptz
 observedAt DateTime @default(now()) @db.Timestamptz
 status String
 @@index([canonicalUrl,checksum])
}
model RunSource {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String @db.Uuid
 runId String @db.Uuid
 sourceSnapshotId String @db.Uuid
 @@unique([runId,sourceSnapshotId])
 @@index([orgId,scopeId,sourceSnapshotId])
}
model CompetitorWatchSource {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String @db.Uuid
 competitorId String @db.Uuid
 url String
 category String
 version Int @default(1)
 @@unique([competitorId,url])
}
model CompetitorSnapshot {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String @db.Uuid
 competitorId String @db.Uuid
 runId String @db.Uuid
 facts Json
 gaps Json
 createdAt DateTime @default(now()) @db.Timestamptz
 @@unique([runId,competitorId])
 @@index([orgId,scopeId,competitorId,createdAt])
}
model CompetitorChange {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String @db.Uuid
 competitorId String @db.Uuid
 runId String @db.Uuid
 field String
 before Json
 after Json
 beforeSnapshotId String @db.Uuid
 afterSnapshotId String @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz
 @@unique([runId,competitorId,field])
 @@index([orgId,scopeId,createdAt])
}
model ResearchBrief {
 id String @id @default(uuid()) @db.Uuid
 orgId String @db.Uuid
 scopeId String @db.Uuid
 runId String @unique @db.Uuid
 title String
 content Json
 evidence Json
 createdAt DateTime @default(now()) @db.Timestamptz
 @@index([orgId,scopeId,createdAt])
}
model AuditRecord {
 id String @id @default(uuid()) @db.Uuid
 orgId String? @db.Uuid
 userId String? @db.Uuid
 action String
 metadata Json
 createdAt DateTime @default(now()) @db.Timestamptz
}
model UsageRecord {
 id String @id @default(uuid()) @db.Uuid
 runId String @db.Uuid
 data Json
 createdAt DateTime @default(now()) @db.Timestamptz
}
model Feedback {
 id String @id @default(uuid()) @db.Uuid
 insightId String @db.Uuid
 userId String @db.Uuid
 useful Boolean
 comment String?
 createdAt DateTime @default(now()) @db.Timestamptz
}
