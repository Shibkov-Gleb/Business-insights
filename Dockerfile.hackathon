FROM node:22.19.0-bookworm-slim AS ocr
RUN apt-get update && apt-get install -y --no-install-recommends openssl=3.0.22-1~deb12u1 ca-certificates=20250419~deb12u2 poppler-utils=22.12.0-2+deb12u3 tesseract-ocr=5.3.0-2 tesseract-ocr-rus=1:4.1.0-2 tesseract-ocr-eng=1:4.1.0-2 && rm -rf /var/lib/apt/lists/*
FROM ocr AS app
RUN npm install -g pnpm@11.25.0
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY packages/agent/package.json packages/agent/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN --mount=type=cache,id=alfa-pnpm,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
COPY . .
ENV DATABASE_URL=postgresql://build:build@localhost/build APP_VARIANT=alfa NEXT_TELEMETRY_DISABLED=1
RUN pnpm db:generate && pnpm --filter @context/web build
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
CMD ["pnpm","api"]
